 "defects": {
  "D1": {
   "id": "D1_token_f1_mislabelled",
   "status": "FIXED_IN_GENERATOR_AND_AGGREGATE",
   "claim": "the 2026-10-25 cloud aggregate's arms.<t>.token_f1 and contrasts.*.token_f1 carried relaxed_accuracy, not token F1",
   "mechanism": "tools/_p1640_p3_second_downstream.py arm_from_payload called the imported token_f1(a, b) with two STRINGS; the function zips its two arguments, so it zipped characters instead of tokens, which on a yes/no label space degenerates to relaxed accuracy.  The --eval path called it correctly as token_f1([nref], [nhyp])",
   "evidence": {
    "pre_correction_aggregate_sha256": "1c389125f0c3ce55056dea67ca5a3ded0ac09740465e37b640989ad66fcfb947",
    "base": {
     "pre_correction_arms_token_f1": 0.8926666666666667,
     "per_arm_archive_token_f1": 0.6826015299515299,
     "per_arm_archive_relaxed_accuracy": 0.8926666666666667,
     "eval_log_printed": "arm=base acc=0.6257 tok_f1=0.8927 (the log printed the same wrong value, so the defect was in the aggregate loader, not in the eval)"
    },
    "r6": {
     "pre_correction_arms_token_f1": 0.846,
     "per_arm_archive_token_f1": 0.8409513227513229,
     "per_arm_archive_relaxed_accuracy": 0.846
    },
    "independent_recomputation": "tools/_p1647_pope_corrected_metrics.py"
   },
   "fix": "token_f1([a], [b]) in arm_from_payload + an assertion that the recomputed mean equals the arm archive's token_f1 field, so the regression cannot reappear silently; the aggregate was regenerated locally on CPU",
   "no_gpu_needed": "the aggregate consumes only the three per-arm archives, so no GPU and no cloud round were required"
  },
  "D2": {
   "id": "D2_verdict_rule_sign_inverted",
   "status": "FIXED_IN_GENERATOR_AND_AGGREGATE",
   "claim": "the pre-correction verdict rule tested the contrast with the opposite sign, so an adapter that was better by more than the margin fired the 'loses' branch",
   "mechanism": "contrasts are delta = arm_a - arm_b with a = base, but the rule tested ci95[0] > 0 for 'keep' and ci95[1] < -margin for 'lose', which are the tests for delta = adapter - base",
   "evidence": {
    "accuracy_base_minus_5": {
     "delta": -0.246,
     "ci95": [
      -0.2626666666666667,
      -0.22965833333333396
     ]
    },
    "accuracy_base_minus_6": {
     "delta": -0.21399999999999997,
     "ci95": [
      -0.23099999999999998,
      -0.19699999999999995
     ]
    },
    "pre_correction_verdict": "task_dependent_effect",
    "adapter_minus_base_accuracy": {
     "r5": 0.246,
     "r6": 0.214
    },
    "why_the_coded_rule_fired": "base - adapter is entirely below -margin for both adapters, which the inverted rule read as 'adapter loses'"
   },
   "fix": "equivalent_or_better = TOST equivalence OR ci95 high < 0; loses = ci95 low > +margin; corrected label is supports_the_adapters on accuracy, and claim_verdict.metric_directions records that yes-class F1 moves the other way, so the label is not read as a blanket endorsement",
   "no_gpu_needed": true
  }
 },
